<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="SpaceClient.View.NavigationWindow"
        Title="Space Command Center" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#FF060B19">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF111B33"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Bauhaus 93"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#FF24335E" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFCA81F5"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FF0D162D" BorderBrush="#FF1E2947" BorderThickness="0,0,2,0" ClipToBounds="True">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Image Source="/Pictures/Helmet.png" Width="60" Height="60" HorizontalAlignment="Left"/>
                    <StackPanel VerticalAlignment="Center" Margin="70,0,0,0">
                        <TextBlock Text="WELCOME" Foreground="#FFAECFFF" FontSize="16" FontFamily="Arial Black" FontWeight="Bold"/>
                        <TextBlock x:Name="nameblock" Text="ABROAD" Foreground="#FFAECFFF" FontSize="16" FontFamily="Arial Black"/>
                    </StackPanel>

                    <Button Content="◀" HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Background="Transparent" Foreground="#FF64748B" BorderThickness="0" 
                            FontSize="16" Cursor="Hand" Click="ToggleSidebar_Click"/>
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,20,0,0">
                    <Button Content="MY PROFILE" Style="{StaticResource NavButtonStyle}" Click="ToProfile_Click" Background="#FF172D5F"/>
                    <Button Content="SPACE FORUM" Style="{StaticResource NavButtonStyle}" Click="ToForum_Click"/>
                    <Button Content="LAUNCHES" Style="{StaticResource NavButtonStyle}" Click="ToProfile_Click" Background="#FF172D5F"/>
                    <Button Content="PHOTO OF THE DAY" Style="{StaticResource NavButtonStyle}" Click="ToImages_Click"/>
                    <Button Content="ISS TRACKING" Style="{StaticResource NavButtonStyle}" Click="ToISS_Click" Background="#FF172D5F"/>
                </StackPanel>

                <Button Grid.Row="2" Content="LANDING (EXIT)" 
        Foreground="#FFFD71CB" Click="Exit_Click"
        Height="50" Margin="0,0,0,12" Cursor="Hand" FontFamily="Bauhaus 93" FontSize="14">

                    <Button.OpacityMask>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black"/>
                            <GradientStop Color="White" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.OpacityMask>

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF1E0F45"/>
                            <Setter Property="BorderBrush" Value="#FF3F1975"/>
                            <Setter Property="BorderThickness" Value="2"/>

                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" Color="Black" Opacity="0.4" ShadowDepth="2"/>
                                </Setter.Value>
                            </Setter>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF4A208C"/>
                                    <Setter Property="Foreground" Value="White"/>

                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#FFFD71CB" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1">

            <Image Source="/Pictures/background.png" Stretch="UniformToFill" Opacity="0.3" Margin="-4,-9,5,0" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-0.794"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <Button x:Name="BtnOpenSidebar" Content="☰ MENU" HorizontalAlignment="Left" VerticalAlignment="Top" 
                    Margin="15" Width="90" Height="35" Visibility="Collapsed"
                    Background="#FF0D162D" Foreground="White" BorderBrush="#FF24335E" 
                    FontFamily="Bauhaus 93" FontSize="12" Cursor="Hand" Click="ToggleSidebar_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>