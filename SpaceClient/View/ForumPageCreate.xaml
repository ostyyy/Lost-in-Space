<Page x:Class="SpaceClient.View.ForumPageCreate"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="New Post" Height="650" Width="900"
      Background="#FF060B19">

    <Page.Resources>
        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF1E0F45"/>
            <Setter Property="Foreground" Value="#FFAECFFF"/>
            <Setter Property="BorderBrush" Value="#FF3F1975"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Bauhaus 93"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Color="Black" Opacity="0.4" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A208C"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#FFFD71CB"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFFD71CB" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
        <Image Source="/Pictures/background.png" Stretch="UniformToFill" Opacity="0.3" Margin="-30" RenderTransformOrigin="0.5,0.5" Panel.ZIndex="-1">
            <Image.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="-0.794"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Border Background="#AA0D162D" BorderBrush="#FF1E2947" BorderThickness="2" CornerRadius="12" 
                Padding="30" MaxWidth="700" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="CREATE NEW POST" Foreground="#FFFD71CB" FontSize="24" FontFamily="Bauhaus 93" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FFFD71CB" BlurRadius="10" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>

                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock Text="TITLE" Foreground="#FF64748B" FontFamily="Bauhaus 93" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtTitle" Background="#FF0D162D" Foreground="White" BorderBrush="#FF3F1975" Height="40" Padding="10,0" FontSize="16" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <TextBlock Text="SELECT OR TYPE TOPIC" Foreground="#FF64748B" FontFamily="Bauhaus 93" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbTopic" IsEditable="True" 
                              ItemsSource="{Binding AvailableTopics}" DisplayMemberPath="Title"
                              Background="#FF0D162D" Foreground="White" BorderBrush="#FF3F1975" 
                              Height="40" Padding="10,5" FontSize="14">
                        <ComboBox.Resources>
                            <Style TargetType="{x:Type TextBox}">
                                <Setter Property="Background" Value="#FF0D162D"/>
                                <Setter Property="Foreground" Value="#FF0D162D"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF0D162D"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF0D162D"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White"/>
                        </ComboBox.Resources>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,25">
                    <TextBlock Text="MESSAGE CONTENT" Foreground="#FF64748B" FontFamily="Bauhaus 93" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtContent" Background="#FF0D162D" Foreground="White" BorderBrush="#FF3F1975" Height="200" Padding="10" FontSize="14" 
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="CANCEL" Style="{StaticResource NavButtonStyle}" Height="50" Foreground="#FFFF4C4C" BorderBrush="#FF751919" Click="Cancel_Click"/>
                    <Button Grid.Column="2" Content="POST" Style="{StaticResource NavButtonStyle}" Height="50" Click="Send_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>