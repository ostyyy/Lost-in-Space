<Page x:Class="SpaceClient.View.APODWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="NASA Astronomy Picture of the Day" Background="#FF060B19" Foreground="White">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Text="LOADING TELEMETRY..." 
                   Foreground="#FFCA81F5" FontSize="22" FontFamily="Bauhaus 93" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#FF24335E" BorderThickness="2" CornerRadius="10" Margin="0,0,15,0" Background="#FF0D162D">
                <Grid>
                    <TextBlock x:Name="TxtLoading" Text="RECEIVING DATA FROM NASA..." 
                               Foreground="#FFAECFFF" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Consolas"/>

                    <Image x:Name="ImgApod" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#CC0D162D" BorderBrush="#FF1E2947" BorderThickness="1" CornerRadius="10" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MISSION LOG / EXPLANATION" Foreground="#FFFD71CB" FontSize="14" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Rectangle Height="1" Fill="#FF24335E" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtExplanation" Text="..." 
                                   Foreground="#FFAECFFF" FontSize="13" FontFamily="Consolas" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
