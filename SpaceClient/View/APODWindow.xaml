<Page x:Class="SpaceClient.View.APODWindow" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="NASA Astronomy Picture of the Day" Background="#FF060B19" Foreground="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="TxtTitle" Text="LOADING TELEMETRY..." 
                       Foreground="#FFCA81F5" FontSize="22" FontFamily="Bauhaus 93" 
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="TxtDate" Text="--.--.----" 
                       Foreground="#FF64748B" FontSize="13" FontFamily="Consolas" 
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="FROM:" Foreground="#FFAECFFF" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="DpStart" Width="120" Height="30" VerticalAlignment="Center" Background="#FF0D162D" BorderBrush="#FF24335E"/>

            <TextBlock Text="TO:" Foreground="#FFAECFFF" FontFamily="Consolas" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <DatePicker x:Name="DpEnd" Width="120" Height="30" VerticalAlignment="Center" Background="#FF0D162D" BorderBrush="#FF24335E"/>

            <Button Content="SEARCH" Width="100" Height="30" Margin="15,0,5,0" 
                    Background="#FF0D162D" Foreground="White" BorderBrush="#FF24335E"
                    FontFamily="Consolas" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="BtnSearchRange_Click"/>

            <Button Content="RANDOM" Width="80" Height="30" Margin="5,0,15,0" 
                    Background="#FF0D162D" Foreground="White" BorderBrush="#FF24335E"
                    FontFamily="Consolas" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="BtnRandom_Click"/>

            <Button x:Name="BtnPrev" Content="◀" Width="35" Height="30" Margin="5,0" IsEnabled="False"
                    Background="#FF0D162D" Foreground="White" BorderBrush="#FF24335E" FontFamily="Consolas" Click="BtnPrev_Click"/>
            <TextBlock x:Name="TxtPages" Text="0/0" Foreground="#FFAECFFF" FontFamily="Consolas" VerticalAlignment="Center" Margin="5,0"/>
            <Button x:Name="BtnNext" Content="▶" Width="35" Height="30" Margin="5,0" IsEnabled="False"
                    Background="#FF0D162D" Foreground="White" BorderBrush="#FF24335E" FontFamily="Consolas" Click="BtnNext_Click"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#FF24335E" BorderThickness="2" CornerRadius="10" Margin="0,0,15,0" Background="#FF0D162D">
                <Grid>
                    <TextBlock x:Name="TxtLoading" Text="RECEIVING DATA FROM NASA..." Foreground="#FFAECFFF" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Consolas"/>
                    <Image x:Name="ImgApod" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#CC0D162D" BorderBrush="#FF1E2947" BorderThickness="1" CornerRadius="10" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MISSION LOG / EXPLANATION" Foreground="#FFFD71CB" FontSize="14" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Rectangle Height="1" Fill="#FF24335E" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtExplanation" Text="..." Foreground="#FFAECFFF" FontSize="13" FontFamily="Consolas" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>