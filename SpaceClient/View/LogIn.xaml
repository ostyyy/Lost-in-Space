<Window x:Class="SpaceClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpaceClient"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="300">
    <Grid Background="Black">
        <Image HorizontalAlignment="Left" Height="65" Margin="10,10,0,0" VerticalAlignment="Top" Width="65" Source="/Pictures/Logo.png">
            <Image.OpacityMask>
                <ImageBrush Stretch="UniformToFill" ImageSource="/Pictures/Logo.png"/>
            </Image.OpacityMask>
        </Image>
        <TextBlock HorizontalAlignment="Left" Margin="80,43,0,0" TextWrapping="Wrap" Text="SPACE" VerticalAlignment="Top" Foreground="White" Height="50" Width="96" FontSize="32" FontFamily="Bauhaus 93"/>
        <TextBlock HorizontalAlignment="Left" Margin="80,11,0,0" TextWrapping="Wrap" Text="LOST IN" VerticalAlignment="Top" Foreground="White" Height="52" Width="106" FontSize="30" FontFamily="Bauhaus 93"/>
        <TextBox HorizontalAlignment="Center" Margin="0,187,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="150" Height="20"/>
        <PasswordBox HorizontalAlignment="Center" Margin="0,256,0,0" VerticalAlignment="Top" Width="150" Height="20"/>
        <Button Content="Explore! " HorizontalAlignment="Center" Margin="0,365,0,0" VerticalAlignment="Top" Width="176" Height="30" Background="White" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <Image HorizontalAlignment="Left" Height="145" Margin="-3,286,0,0" VerticalAlignment="Top" Width="141" Source="/Pictures/stars.png" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="12.413"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
            <Image.OpacityMask>
                <ImageBrush ImageSource="/Pictures/stars.png" Stretch="UniformToFill"/>
            </Image.OpacityMask>
        </Image>
        <Image HorizontalAlignment="Left" Height="83" Margin="205,123,0,0" VerticalAlignment="Top" Width="105" Source="/Pictures/stars.png" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="209.492"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
            <Image.OpacityMask>
                <ImageBrush ImageSource="/Pictures/stars.png" Stretch="UniformToFill"/>
            </Image.OpacityMask>
        </Image>
        <TextBlock HorizontalAlignment="Left" Margin="75,164,0,0" TextWrapping="Wrap" Text="Login:" VerticalAlignment="Top" Foreground="White" Height="22" Width="53" FontFamily="Bauhaus 93" FontSize="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="75,233,0,0" TextWrapping="Wrap" Text="Password:" VerticalAlignment="Top" Foreground="White" Height="22" Width="75" FontFamily="Bauhaus 93" FontSize="16"/>

    </Grid>
</Window>
