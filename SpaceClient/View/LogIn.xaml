<Window x:Class="SpaceClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpaceClient"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="300">
    <Grid Background="Black">
        <Image HorizontalAlignment="Left" Height="100" Margin="133,38,0,0" VerticalAlignment="Top" Width="117">
            <Image.OpacityMask>
                <ImageBrush ImageSource="/Pictures/Logo.png" Stretch="UniformToFill"/>
            </Image.OpacityMask>
        </Image>

    </Grid>
</Window>
