<Page x:Class="SpaceClient.View.PostDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Post Discussion" d:DesignHeight="700" d:DesignWidth="900"
      Background="#FF060B19">

    <Page.Resources>
        <ControlTemplate x:Key="NeonButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" 
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="CommentActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content=" BACK TO FORUM" HorizontalAlignment="Right" Padding="15,8" 
                FontSize="12" FontFamily="Bauhaus 93" Cursor="Hand" Click="Back_Click"
                Background="#FF1E0F45" Foreground="#FFAECFFF" BorderBrush="#FF3F1975" FlowDirection="RightToLeft"
                Template="{StaticResource NeonButtonTemplate}"/>

        <Border Grid.Row="1" Background="#AA0D162D" BorderBrush="#FF1E2947" BorderThickness="2" CornerRadius="12" Margin="0,20,0,10" Padding="20">
            <StackPanel>
                <TextBlock x:Name="TxtPostTitle" Text="{Binding PostTitle}" Foreground="#FFAECFFF" FontSize="24" FontFamily="Bauhaus 93"/>
                <TextBlock x:Name="TxtPostTopic" Text="{Binding PostTopic}" Foreground="#FFFFD74C" FontSize="16" FontFamily="Consolas" Margin="0,5,0,15"/>
                <TextBlock x:Name="TxtPostContent" Text="{Binding PostContent}" Foreground="White" FontSize="16" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="DISCUSSION" Foreground="#FFFD71CB" FontFamily="Bauhaus 93" FontSize="18" Margin="0,0,0,10"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                <ItemsControl x:Name="CommentsItemsControl" ItemsSource="{Binding Comments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0AFFFFFF" BorderBrush="#FF1E2947" BorderThickness="1" 
                                    CornerRadius="8" Margin="{Binding LeftMargin}" Padding="15,10" Name="CommentBorder">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <TextBlock Text="{Binding AuthorName}" Foreground="#FF26E6FF" FontWeight="Bold" FontSize="14" FontFamily="Consolas"/>
                                        <TextBlock Text=" • " Foreground="#44FFFFFF"/>
                                        <TextBlock Text="{Binding CreatedDate}" Foreground="#66FFFFFF" FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Content}" Foreground="White" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>

                                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                                        <Button Content="DELETE" 
                                                Background="Transparent" Foreground="#FFFF4444" BorderBrush="#FFFF4444"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource CommentActionButtonStyle}"
                                                Visibility="{Binding DeleteButtonVisibility}"
                                                Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding Id}"/>

                                        <Button Content="REPLY" 
                                                Background="#00000000" Foreground="#FFFD71CB" BorderBrush="#FFFD71CB"
                                                Style="{StaticResource CommentActionButtonStyle}"
                                                Command="{Binding DataContext.ReplyCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding Id}"/>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Background="#FF0D162D">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="ReplyIndicatorPanel" Orientation="Horizontal" Visibility="{Binding ReplyIndicatorVisibility}" Margin="5,5,5,10">
                    <TextBlock Text="Replying to comment... " Foreground="#FFFFD74C" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <Button Content="Cancel" Foreground="#FFFD71CB" Background="Transparent" BorderThickness="1,1,1,1" Cursor="Hand" 
                            Command="{Binding CancelReplyCommand}" BorderBrush="#FFFF44C4" Margin="4,4,4,4" IsTabStop="False" Padding="3,3,3,3"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtCommentInput" Background="#FF131C38" Foreground="White" BorderBrush="#FF25315B" 
                             CaretBrush="White" FontSize="14" Padding="10" Height="45" VerticalContentAlignment="Center"
                             Text="{Binding CommentInputText, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Grid.Column="1" Content="SEND" Width="100" Margin="10,0,0,0"
                            Background="#FF1E0F45" Foreground="#FFFD71CB" BorderBrush="#FFFD71CB"
                            FontFamily="Bauhaus 93" FontSize="14" Cursor="Hand" 
                            Command="{Binding SendCommentCommand}"
                            Template="{StaticResource NeonButtonTemplate}"/>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Page>