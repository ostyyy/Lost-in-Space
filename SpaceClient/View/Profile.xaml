<Page x:Class="SpaceClient.View.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:SpaceClient.View"
      mc:Ignorable="d"
      Title="Profile" d:DesignHeight="650" d:DesignWidth="900"
      Background="#FF060B19">

    <Page.Resources>
        <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF2D0D16"/>
            <Setter Property="Foreground" Value="#FFFF4C4C"/>
            <Setter Property="BorderBrush" Value="#FF751919"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Bauhaus 93"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Color="Black" Opacity="0.4" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A1520"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#FFFF4C4C"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFFF4C4C" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.RowSpan="3" Source="/Pictures/background.png" Stretch="UniformToFill" Opacity="0.3" Margin="-30" Panel.ZIndex="-1"/>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
            <Image Source="/Pictures/Helmet.png" Height="90" Width="90" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock x:Name="TxtUserName" Text="{Binding Login}" Foreground="#FFAECFFF" FontSize="36" FontFamily="Bauhaus 93" HorizontalAlignment="Center" Margin="0,5,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FFAECFFF" BlurRadius="10" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="MY POSTS" Foreground="#FF64748B" FontFamily="Bauhaus 93" FontSize="20" Margin="0,0,0,10" HorizontalAlignment="Center"/>

            <Border Grid.Row="1" Background="#AA0D162D" BorderBrush="#FF1E2947" BorderThickness="2" CornerRadius="12" Padding="20" MaxWidth="700">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PostsContainer">
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Button Grid.Row="2" x:Name="DeleteAccountBtn" Content="DELETE ACCOUNT" Style="{StaticResource DangerButtonStyle}" 
                HorizontalAlignment="Center" Height="50" Width="200" Click="DeleteAccountBtn_Click"/>
    </Grid>
</Page>