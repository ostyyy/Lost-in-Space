<Window x:Class="SpaceClient.View.Profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpaceClient.View"
        mc:Ignorable="d"
        Title="Profile" Height="450" Width="800">
    <Grid Background="#FF0A0D1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="104*"/>
            <RowDefinition Height="113*"/>
        </Grid.RowDefinitions>
        <Image HorizontalAlignment="Left" Height="431" VerticalAlignment="Top" Width="796" Grid.RowSpan="2" Source="/Pictures/background.png">
            <Image.OpacityMask>
                <ImageBrush ImageSource="/Pictures/background.png" Stretch="UniformToFill"/>
            </Image.OpacityMask>
        </Image>
        <Image HorizontalAlignment="Left" Height="62" Margin="10,10,0,0" VerticalAlignment="Top" Width="64" Source="/Pictures/Helmet.png">
            <Image.OpacityMask>
                <ImageBrush ImageSource="/Pictures/Helmet.png" Stretch="UniformToFill"/>
            </Image.OpacityMask>
        </Image>
        <TextBlock HorizontalAlignment="Left" Margin="80,11,0,0" TextWrapping="Wrap" Text="WELCOME ABOARD," VerticalAlignment="Top" Foreground="White" Height="42" Width="280" FontSize="30" FontFamily="Bauhaus 93"/>
        <TextBlock HorizontalAlignment="Left" Margin="80,41,0,0" TextWrapping="Wrap" Text="nameblock" VerticalAlignment="Top" Foreground="White" Height="37" Width="263" FontSize="30" FontFamily="Bauhaus 93"/>
        <Button x:Name="ToISSbtn" Content="" HorizontalAlignment="Left" Margin="555,177,0,0" VerticalAlignment="Top" Height="80" Width="80" Grid.RowSpan="2">
            <Button.Background>
                <ImageBrush Stretch="UniformToFill" ImageSource="/Pictures/ISS.png"/>
            </Button.Background>
        </Button>
        <Button x:Name="ToForumbtn" Content="" HorizontalAlignment="Left" Margin="156,177,0,0" VerticalAlignment="Top" Height="80" Width="80" Grid.RowSpan="2" Click="ToForumbtn_Click">
            <Button.Background>
                <ImageBrush Stretch="UniformToFill" ImageSource="/Pictures/ForumLogo.png"/>
            </Button.Background>
        </Button>
        <Button x:Name="ToImagesbtn" Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Height="80" Width="80" Margin="0,177,0,0" Grid.RowSpan="2">
            <Button.Background>
                <ImageBrush Stretch="UniformToFill" ImageSource="/Pictures/NASA.png"/>
            </Button.Background>
        </Button>
        <TextBlock HorizontalAlignment="Left" Margin="125,54,0,0" TextWrapping="Wrap" Text="Explore Forum" VerticalAlignment="Top" Foreground="White" Height="37" Width="142" FontSize="22" FontFamily="Bauhaus 93" Grid.Row="1"/>
        <TextBlock HorizontalAlignment="Left" Margin="535,54,0,0" TextWrapping="Wrap" Text="ISS Tracking" VerticalAlignment="Top" Foreground="White" Height="37" Width="120" FontSize="22" FontFamily="Bauhaus 93" Grid.Row="1"/>
        <TextBlock HorizontalAlignment="Left" Margin="360,54,0,0" TextWrapping="Wrap" Text="Image of the Day" VerticalAlignment="Top" Foreground="White" Height="80" Width="103" FontSize="22" FontFamily="Bauhaus 93" Grid.Row="1"/>
        <Button x:Name="Exitbtn" Content="" HorizontalAlignment="Left" Margin="691,140,0,0" VerticalAlignment="Top" Height="63" Width="64" Click="ExitButton_Click" Grid.Row="1">
            <Button.Background>
                <ImageBrush Stretch="UniformToFill" ImageSource="/Pictures/Landing.png"/>
            </Button.Background>
        </Button>
        <Image HorizontalAlignment="Left" Height="61" Margin="7,71,0,0" VerticalAlignment="Top" Width="66" Source="/Pictures/stars.png" Opacity="0.6" RenderTransformOrigin="0.5,0.5" Grid.Row="1">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="12.413"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
            <Image.OpacityMask>
                <ImageBrush ImageSource="/Pictures/stars.png" Stretch="UniformToFill"/>
            </Image.OpacityMask>
        </Image>
        <Image HorizontalAlignment="Left" Height="78" Margin="69,124,0,0" VerticalAlignment="Top" Width="73" Source="/Pictures/stars.png" Opacity="0.6" RenderTransformOrigin="0.5,0.5" Grid.Row="1">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="12.413"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
            <Image.OpacityMask>
                <ImageBrush ImageSource="/Pictures/stars.png" Stretch="UniformToFill"/>
            </Image.OpacityMask>
        </Image>
        <Image HorizontalAlignment="Left" Height="77" Margin="16,131,0,0" VerticalAlignment="Top" Width="73" Source="/Pictures/stars.png" Opacity="0.6" RenderTransformOrigin="0.5,0.5" Grid.Row="1">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="12.413"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
            <Image.OpacityMask>
                <ImageBrush ImageSource="/Pictures/stars.png" Stretch="UniformToFill"/>
            </Image.OpacityMask>
        </Image>
        <Image HorizontalAlignment="Left" Height="61" Margin="671,-7,0,0" VerticalAlignment="Top" Width="66" Source="/Pictures/stars.png" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="192.626"/>
                    <TranslateTransform X="62.746" Y="86.9"/>
                </TransformGroup>
            </Image.RenderTransform>
            <Image.OpacityMask>
                <ImageBrush ImageSource="/Pictures/stars.png" Stretch="UniformToFill"/>
            </Image.OpacityMask>
        </Image>
        <Image HorizontalAlignment="Left" Height="78" Margin="733,46,0,0" VerticalAlignment="Top" Width="73" Source="/Pictures/stars.png" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="192.626"/>
                    <TranslateTransform X="-67.067" Y="-35.148"/>
                </TransformGroup>
            </Image.RenderTransform>
            <Image.OpacityMask>
                <ImageBrush ImageSource="/Pictures/stars.png" Stretch="UniformToFill"/>
            </Image.OpacityMask>
        </Image>
        <Image HorizontalAlignment="Left" Height="77" Margin="680,53,0,0" VerticalAlignment="Top" Width="73" Source="/Pictures/stars.png" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="192.626"/>
                    <TranslateTransform X="38.741" Y="-47.975"/>
                </TransformGroup>
            </Image.RenderTransform>
            <Image.OpacityMask>
                <ImageBrush ImageSource="/Pictures/stars.png" Stretch="UniformToFill"/>
            </Image.OpacityMask>
        </Image>
        <TextBlock HorizontalAlignment="Left" Margin="691,194,0,0" TextWrapping="Wrap" Text="Go back" VerticalAlignment="Top" Foreground="#FFF30000" Height="32" Width="68" FontSize="16" FontFamily="Bauhaus 93" Grid.Row="1"/>

    </Grid>
</Window>
