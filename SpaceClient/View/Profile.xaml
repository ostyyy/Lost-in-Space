<Window x:Class="SpaceClient.View.Profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpaceClient.View"
        mc:Ignorable="d"
        Title="Profile" Height="450" Width="800">
    <Grid Background="Black">
        <Image HorizontalAlignment="Left" Height="62" Margin="10,10,0,0" VerticalAlignment="Top" Width="64" Source="/Pictures/Helmet.png">
            <Image.OpacityMask>
                <ImageBrush ImageSource="/Pictures/Helmet.png" Stretch="UniformToFill"/>
            </Image.OpacityMask>
        </Image>
        <TextBlock HorizontalAlignment="Left" Margin="80,11,0,0" TextWrapping="Wrap" Text="WELCOME ABOARD," VerticalAlignment="Top" Foreground="White" Height="42" Width="280" FontSize="30" FontFamily="Bauhaus 93"/>
        <TextBlock HorizontalAlignment="Left" Margin="80,41,0,0" TextWrapping="Wrap" Text="nameblock" VerticalAlignment="Top" Foreground="White" Height="37" Width="263" FontSize="30" FontFamily="Bauhaus 93"/>
        <Button Content="" HorizontalAlignment="Left" Margin="555,0,0,0" VerticalAlignment="Center" Height="80" Width="80">
            <Button.Background>
                <ImageBrush Stretch="UniformToFill" ImageSource="/Pictures/ISS.png"/>
            </Button.Background>
        </Button>
        <Button Content="" HorizontalAlignment="Left" Margin="156,0,0,0" VerticalAlignment="Center" Height="80" Width="80">
            <Button.Background>
                <ImageBrush Stretch="UniformToFill" ImageSource="/Pictures/ForumLogo.png"/>
            </Button.Background>
        </Button>
        <Button Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Height="80" Width="80">
            <Button.Background>
                <ImageBrush Stretch="UniformToFill" ImageSource="/Pictures/NASA.png"/>
            </Button.Background>
        </Button>
        <TextBlock HorizontalAlignment="Left" Margin="125,262,0,0" TextWrapping="Wrap" Text="Explore Forum" VerticalAlignment="Top" Foreground="White" Height="37" Width="142" FontSize="22" FontFamily="Bauhaus 93"/>
        <TextBlock HorizontalAlignment="Left" Margin="535,262,0,0" TextWrapping="Wrap" Text="ISS Tracking" VerticalAlignment="Top" Foreground="White" Height="37" Width="120" FontSize="22" FontFamily="Bauhaus 93"/>
        <TextBlock HorizontalAlignment="Left" Margin="360,262,0,0" TextWrapping="Wrap" Text="Image of the Day" VerticalAlignment="Top" Foreground="White" Height="80" Width="103" FontSize="22" FontFamily="Bauhaus 93"/>

    </Grid>
</Window>
